    "test:access": "node tests/access-browser.mjs",
    "test:drive": "node tests/drive-features-browser.mjs",
    "test:bots": "node tests/bots-browser.mjs",
    "dev:editor": "node tools/local-editor-server.mjs",
    "test:local-mocks": "node tests/local-tracks-browser.mjs",
    "build:pages": "node tools/build_demo.mjs . dist --pages-preview",
    "test:pages": "node tests/pages-browser.mjs",
    "test:imports": "node tests/three-imports-browser.mjs",
    "test:free": "node tests/free-drive-browser.mjs",
    "test:motorway": "node tests/motorway-lessons-browser.mjs",
