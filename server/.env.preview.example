# Copy to an ignored .env file or configure the GitHub cloudflare environment.
# Use a separate Neon branch and Clerk development instance; Stripe test mode only.
# The visual cockpit preview needs none of these billing settings.
PREVIEW_DATABASE_URL=
PREVIEW_DATABASE_HOST=
PRODUCTION_DATABASE_HOST=
PREVIEW_CLERK_SECRET_KEY=
PREVIEW_CLERK_PUBLISHABLE_KEY=
PREVIEW_STRIPE_SECRET_KEY=
PREVIEW_STRIPE_PRICE_ID=
# Local deployment only; GitHub already has CLOUD_FLAIR_API_TOKEN / CLOUD_FLAIR_ID.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PREVIEW_ALIAS=cockpit-review
